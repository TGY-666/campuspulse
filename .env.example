# ============================================================
# 环境变量模板 —— 复制为 .env 后填入自己的值
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# 请勿把 .env 提交到版本库；本模板不含任何真实密钥。
# ============================================================

# ---- 大模型（可选）----
# 未填写时系统自动降级为「规则路由」模式：功能可用，但不生成自然语言回答。
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ---- 服务端口（可选，默认 8000，被占用时自动顺延）----
# PORT=8000

# ---- 功能开关（可选，默认值见 README 第 4.3 节）----
# 认证与角色：0=关闭（免登录，仅本机调试），1=开启
# CP_AUTH=1
# 处置工单模块：0=隐藏，1=显示
# CP_TICKETS=1
# 引用核验：1=开启引用硬阻断与自动重写/剥离（默认），0=仅记录不阻断
# CP_CITATION_GUARD=1
# 大模型名称（默认 deepseek-chat）
# DEEPSEEK_MODEL=deepseek-chat
# 工具通道：local=进程内直调，mcp=MCP 标准协议子进程
# CP_TOOL_CHANNEL=local
# 多租户：1=开启租户隔离（默认）
# CP_TENANCY=1

# ---- 数据库与日志（可选）----
# CP_DB_PATH=data/campuspulse.db
# CP_LOG_LEVEL=INFO
