# ============================================================
# 环境变量模板 —— 复制为 .env 后填入自己的值
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# .env 已被 .gitignore 排除，不会被提交。
# ============================================================

# ---- 大模型（必填）----
# 未填写时系统自动降级为「规则路由」模式：功能可用，但不生成自然语言回答。
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ---- 服务端口（可选，默认 8000，被占用时自动顺延）----
# PORT=8000

# ---- 功能开关（可选，默认值见 README 第 5 节）----
# 认证与角色：0=关闭（免登录，仅本机调试），1=开启
# CP_AUTH=1
# 处置工单模块：0=隐藏，1=显示
# CP_TICKETS=1
# 引用核验：enforce=硬阻断（默认）/ warn=只提示 / off=关闭
# CP_CITATION_GUARD=enforce
# 多租户：1=开启租户隔离（默认）
# CP_TENANCY=1

# ---- 数据库与日志（可选）----
# CP_DB_PATH=data/campuspulse.db
# CP_LOG_LEVEL=INFO
